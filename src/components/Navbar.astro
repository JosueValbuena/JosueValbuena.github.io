---
import { ChevronDown, Menu, X } from "@lucide/astro";
import { servicePages } from "../data/servicePages";

const serviceLinks = servicePages.map((page) => ({
  label: page.navLabel,
  href: `/servicios/${page.slug}/`,
}));

const navLinks = [
  { label: "Servicios", href: "/servicios/", children: serviceLinks },
  { label: "Proyectos", href: "/#proyectos" },
  { label: "Proceso", href: "/#proceso" },
  { label: "Experiencia", href: "/#experiencia" },
  { label: "Contacto", href: "/#contacto" },
];
---

<nav
  class="fixed top-0 left-0 right-0 z-50 bg-background/80 backdrop-blur-lg border-b border-border/50"
>
  <div
    class="container max-w-6xl mx-auto px-6 flex items-center justify-between h-16"
  >
    <a
      href="/"
      class="text-xl font-bold font-heading text-gradient"
      aria-label="Ir a la página principal"
    >
      JRVH
    </a>

    <div class="hidden md:flex items-center gap-8">
      {
        navLinks.map((link) =>
          link.children ? (
            <div class="relative group">
              <a
                href={link.href}
                class="flex items-center gap-1 text-sm text-muted-foreground hover:text-foreground transition-colors"
                aria-label={`Ir a ${link.label}`}
                aria-haspopup="true"
              >
                {link.label}
                <ChevronDown
                  size={14}
                  class="transition-transform group-hover:rotate-180 group-focus-within:rotate-180"
                />
              </a>
              <div class="absolute left-1/2 -translate-x-1/2 top-full pt-4 hidden group-hover:block group-focus-within:block">
                <div class="min-w-52 rounded-lg border border-border bg-background p-2 shadow-lg">
                  {link.children.map((child) => (
                    <a
                      href={child.href}
                      class="block rounded-md px-3 py-2 text-sm text-muted-foreground hover:bg-secondary hover:text-foreground transition-colors"
                    >
                      {child.label}
                    </a>
                  ))}
                </div>
              </div>
            </div>
          ) : (
            <a
              href={link.href}
              class="text-sm text-muted-foreground hover:text-foreground transition-colors"
              aria-label={`Ir a ${link.label}`}
            >
              {link.label}
            </a>
          ),
        )
      }
    </div>

    <button
      id="menu-btn"
      class="md:hidden text-foreground"
      aria-label="Toggle menu"
    >
      <Menu id="icon-menu" size={24} />
      <X id="icon-close" size={24} class="hidden" />
    </button>
  </div>

  <div
    id="mobile-menu"
    class="hidden md:hidden bg-background border-b border-border px-6 py-4 space-y-3"
  >
    {
      navLinks.map((link) => (
        <>
          <a
            href={link.href}
            class="mobile-link block text-sm text-muted-foreground hover:text-foreground transition-colors"
            aria-label={`Ir a ${link.label}`}
          >
            {link.label}
          </a>
          {link.children?.map((child) => (
            <a
              href={child.href}
              class="mobile-link block pl-4 text-sm text-muted-foreground/80 hover:text-foreground transition-colors"
            >
              — {child.label}
            </a>
          ))}
        </>
      ))
    }
  </div>
</nav>

<script>
  const btn = document.getElementById("menu-btn");
  const menu = document.getElementById("mobile-menu");
  const iconMenu = document.getElementById("icon-menu");
  const iconClose = document.getElementById("icon-close");
  const links = document.querySelectorAll(".mobile-link");

  const toggleMenu = () => {
    menu?.classList.toggle("hidden");
    iconMenu?.classList.toggle("hidden");
    iconClose?.classList.toggle("hidden");
  };

  btn?.addEventListener("click", toggleMenu);
  links.forEach((link) => link.addEventListener("click", toggleMenu));
</script>
