---
import {
  Monitor,
  ShoppingCart,
  LayoutDashboard,
  Bot,
  Workflow,
  RefreshCw,
} from "@lucide/astro";

const services = [
  {
    icon: Monitor,
    title: "Sitio web profesional",
    href: "/servicios/desarrollo-web/",
    color: "hsl(160 84% 39%)",
    description:
      "Una web que presenta tu negocio y te trae clientes desde Google.",
    items: [
      "Diseño responsivo, pensado primero para el celular",
      "Optimizado para SEO y carga rápida",
      "Formularios y botón de WhatsApp",
      "Landing pages y sitios corporativos",
    ],
  },
  {
    icon: ShoppingCart,
    title: "Tienda online",
    href: "/servicios/tienda-online/",
    color: "hsl(200 80% 55%)",
    description:
      "Vende tus productos las 24 horas, con tu propio panel de control.",
    items: [
      "Catálogo y carrito de compras",
      "Pasarelas de pago",
      "Panel para gestionar productos y pedidos",
      "Blog para atraer más visitas",
    ],
  },
  {
    icon: LayoutDashboard,
    title: "Sistema o aplicación a medida",
    href: "/servicios/aplicaciones-a-medida/",
    color: "hsl(280 70% 60%)",
    description: "Software hecho para cómo funciona tu negocio, no al revés.",
    items: [
      "Paneles administrativos y dashboards",
      "Inicio de sesión, roles y permisos",
      "Gestión de datos y reportes",
      "Integración con otras plataformas y APIs",
    ],
  },
  {
    icon: Bot,
    title: "Chatbots y agentes de IA",
    href: "/servicios/chatbots-ia/",
    color: "hsl(190 80% 55%)",
    description:
      "Atiende a tus clientes y resuelve consultas sin que tengas que estar siempre disponible.",
    items: [
      "Chatbots para tu web y WhatsApp",
      "Agentes que responden con la información de tu negocio",
      "Integración con OpenAI, Gemini y Claude",
      "Derivación a una persona cuando hace falta",
    ],
  },
  {
    icon: Workflow,
    title: "Automatización de procesos",
    href: "/servicios/automatizacion/",
    color: "hsl(30 80% 55%)",
    description: "Ahorra horas de trabajo repetitivo y reduce errores.",
    items: [
      "Conexión entre tus herramientas y sistemas",
      "Envío automático de correos y notificaciones",
      "Procesamiento de formularios y documentos",
      "Reportes generados automáticamente",
    ],
  },
  {
    icon: RefreshCw,
    title: "Mejora o rediseño de tu sitio",
    href: "/servicios/rediseno-web/",
    color: "hsl(340 70% 55%)",
    description:
      "¿Ya tienes una web que es lenta, antigua o no te trae resultados?",
    items: [
      "Rediseño moderno y adaptado al celular",
      "Mejora de velocidad y posicionamiento",
      "Migración a una tecnología actual",
      "Corrección de errores y mantenimiento",
    ],
  },
];
---

<section id="servicios" class="py-24 px-6">
  <div class="max-w-6xl mx-auto">
    
    <!-- Header -->
    <div class="text-center mb-16">
      <h2 class="text-4xl md:text-5xl font-bold mb-4">
        Lo que puedo hacer <span class="text-gradient">por tu negocio</span>
      </h2>
      <p class="text-muted-foreground max-w-xl mx-auto">
        Cuéntame qué necesitas y lo convierto en una solución web que funcione
      </p>
    </div>

    <!-- Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
      {services.map((service) => {
        const Icon = service.icon;

        return (
          <div class="card-gradient rounded-xl p-6 border border-border hover:border-primary/30 hover-glow transition-all group">
            
            <div
              class="w-12 h-12 rounded-lg flex items-center justify-center mb-4 border"
              style={`border-color: ${service.color}40; background: ${service.color}10;`}
            >
              <Icon size={24} style={`color: ${service.color};`} />
            </div>

            <h3 class="text-lg font-semibold mb-2 text-foreground">
              {service.title}
            </h3>

            <p class="text-sm text-secondary-foreground/80 mb-4 leading-relaxed">
              {service.description}
            </p>

            <ul class="space-y-1.5">
              {service.items.map((item) => (
                <li class="text-sm text-muted-foreground flex items-center gap-2">
                  <span
                    class="w-1.5 h-1.5 rounded-full shrink-0"
                    style={`background: ${service.color};`}
                  />
                  {item}
                </li>
              ))}
            </ul>

            {service.href && (
              <a
                href={service.href}
                class="inline-block mt-5 text-sm text-primary hover:underline"
                aria-label={`Más información sobre ${service.title}`}
              >
                Ver más →
              </a>
            )}

          </div>
        );
      })}
    </div>

    <div class="text-center mt-10">
      <a href="/servicios/" class="text-primary hover:underline">
        Ver todos los servicios →
      </a>
    </div>

  </div>
</section>