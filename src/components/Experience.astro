---
import { Image } from "astro:assets";
// import sbpay from "../assets/logos/sbpay.webp";
// import kibernum from "../assets/logos/kibernum.webp";
import firmavirtual from "../assets/logos/firmavirtual.webp";

const jobs = [
  // {
  //   company: "sbpay",
  //   logo: sbpay,
  //   role: "Desarrollador Fullstack-mobile",
  //   period: "Ago 2026 – Actualidad",
  // },
  // {
  //   company: "Kibernum",
  //   logo: kibernum,
  //   role: "Desarrollador Fullstack-mobile",
  //   period: "Ago 2026 – Actualidad",
  // },
  {
    company: "FirmaVirtual",
    logo: firmavirtual,
    role: "Front-End Developer",
    period: "Ene 2024 – Actualidad",
    tasks: [
      "Transformación de diseños Figma a interfaces interactivas con React y Material UI",
      "Refactorización de componentes de +2500 líneas en módulos reutilizables",
      "Implementación de lazy loading para mejorar rendimiento",
      "Desarrollo Mobile First en plataforma de firma electrónica",
    ],
    tech: ["React", "Material UI", "TypeScript", "Figma"],
  },
];
---

<section id="experiencia" class="py-24 px-6">
  <div class="container max-w-6xl mx-auto">

    <!-- Header -->
    <div class="text-center mb-16">
      <h2 class="text-4xl md:text-5xl font-bold mb-4">
        Experiencia{" "}
        <span class="bg-linear-to-r from-emerald-400 to-cyan-400 bg-clip-text text-transparent">
          profesional
        </span>
      </h2>
    </div>

    <div class="max-w-3xl mx-auto">

      <!-- Cards Experiencia -->
      <div class="space-y-6">
        {
          jobs.map((job) => (
            <div class="rounded-xl border border-zinc-800 p-8 hover:border-emerald-500/30 transition-all bg-zinc-900">
              <div class="flex items-start gap-4">
                <div class="w-12 h-12 rounded-lg overflow-hidden bg-white border border-zinc-700 flex items-center justify-center shrink-0">
                  <Image
                    src={job.logo}
                    alt={`Logo de ${job.company}`}
                    width={48}
                    height={48}
                    class="w-full h-full object-contain"
                  />
                </div>

                <div class="flex-1">
                  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between mb-2">
                    <h3 class="text-xl font-semibold text-white">
                      {job.company}
                    </h3>
                    <span class="text-sm text-gray-400">{job.period}</span>
                  </div>

                  <p class="text-emerald-400 text-sm font-medium">
                    {job.role}
                  </p>

                  {job.tasks && (
                    <ul class="space-y-2 text-sm text-gray-400 mt-4">
                      {job.tasks.map((task) => (
                        <li class="flex gap-2">
                          <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 shrink-0 mt-1.5" />
                          {task}
                        </li>
                      ))}
                    </ul>
                  )}

                  {job.tech && (
                    <div class="flex flex-wrap gap-2 mt-4">
                      {job.tech.map((t) => (
                        <span class="text-xs bg-zinc-800 text-gray-300 px-2.5 py-1 rounded-md">
                          {t}
                        </span>
                      ))}
                    </div>
                  )}
                </div>
              </div>
            </div>
          ))
        }
      </div>

      <!-- Stack tecnológico -->
      <div class="mt-12">

        <h3 class="text-lg font-semibold text-center mb-6 text-white">
          Stack tecnológico
        </h3>

        <div class="flex flex-wrap justify-center gap-3">
        
          <span class="px-4 py-2 text-sm rounded-lg border border-zinc-800 bg-zinc-900 text-gray-300 hover:border-emerald-500/30 transition-colors">
            JavaScript
          </span>
          <span class="px-4 py-2 text-sm rounded-lg border border-zinc-800 bg-zinc-900 text-gray-300 hover:border-emerald-500/30 transition-colors">
            TypeScript
          </span>
          <span class="px-4 py-2 text-sm rounded-lg border border-zinc-800 bg-zinc-900 text-gray-300 hover:border-emerald-500/30 transition-colors">
            React
          </span>
          <span class="px-4 py-2 text-sm rounded-lg border border-zinc-800 bg-zinc-900 text-gray-300 hover:border-emerald-500/30 transition-colors">
            Next.js
          </span>
          <span class="px-4 py-2 text-sm rounded-lg border border-zinc-800 bg-zinc-900 text-gray-300 hover:border-emerald-500/30 transition-colors">
            Node.js
          </span>
          <span class="px-4 py-2 text-sm rounded-lg border border-zinc-800 bg-zinc-900 text-gray-300 hover:border-emerald-500/30 transition-colors">
            Express
          </span>
          <span class="px-4 py-2 text-sm rounded-lg border border-zinc-800 bg-zinc-900 text-gray-300 hover:border-emerald-500/30 transition-colors">
            PostgreSQL
          </span>
          <span class="px-4 py-2 text-sm rounded-lg border border-zinc-800 bg-zinc-900 text-gray-300 hover:border-emerald-500/30 transition-colors">
            Prisma ORM
          </span>
          <span class="px-4 py-2 text-sm rounded-lg border border-zinc-800 bg-zinc-900 text-gray-300 hover:border-emerald-500/30 transition-colors">
            Tailwind CSS
          </span>
          <span class="px-4 py-2 text-sm rounded-lg border border-zinc-800 bg-zinc-900 text-gray-300 hover:border-emerald-500/30 transition-colors">
            Material UI
          </span>
          <span class="px-4 py-2 text-sm rounded-lg border border-zinc-800 bg-zinc-900 text-gray-300 hover:border-emerald-500/30 transition-colors">
            Shadcn/UI
          </span>
          <span class="px-4 py-2 text-sm rounded-lg border border-zinc-800 bg-zinc-900 text-gray-300 hover:border-emerald-500/30 transition-colors">
            Git
          </span>
          <span class="px-4 py-2 text-sm rounded-lg border border-zinc-800 bg-zinc-900 text-gray-300 hover:border-emerald-500/30 transition-colors">
            GitHub
          </span>
          <span class="px-4 py-2 text-sm rounded-lg border border-zinc-800 bg-zinc-900 text-gray-300 hover:border-emerald-500/30 transition-colors">
            Figma
          </span>
          <span class="px-4 py-2 text-sm rounded-lg border border-zinc-800 bg-zinc-900 text-gray-300 hover:border-emerald-500/30 transition-colors">
            AWS S3
          </span>
          <span class="px-4 py-2 text-sm rounded-lg border border-zinc-800 bg-zinc-900 text-gray-300 hover:border-emerald-500/30 transition-colors">
            Claude Code
          </span>

        </div>
      </div>

    </div>
  </div>
</section>