---
interface Props {
  items: { question: string; answer: string }[];
  id?: string;
}

const { items, id = "preguntas-frecuentes" } = Astro.props;
---

<section id={id} class="py-16 px-6">
  <div class="max-w-3xl mx-auto">
    <h2 class="text-3xl md:text-4xl font-bold text-center mb-12">
      Preguntas <span class="text-gradient">frecuentes</span>
    </h2>
    <div class="space-y-3">
      {
        items.map((item) => (
          <details class="group rounded-xl border border-border p-5 open:border-primary/30">
            <summary class="cursor-pointer list-none flex items-center justify-between gap-4 font-medium text-foreground">
              {item.question}
              <span class="text-primary text-xl transition-transform group-open:rotate-45">+</span>
            </summary>
            <p class="mt-3 text-sm text-secondary-foreground/80 leading-relaxed">
              {item.answer}
            </p>
          </details>
        ))
      }
    </div>
  </div>
</section>
