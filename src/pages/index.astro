---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import Services from "../components/Services.astro";
import Projects from "../components/Projects.astro";
import Process from "../components/Process.astro";
import Experience from "../components/Experience.astro";
import Contact from "../components/Contact.astro";
import Faq from "../components/Faq.astro";
import { generalFaq } from "../data/faq";

const faqJsonLd = {
  "@type": "FAQPage",
  mainEntity: generalFaq.map((item) => ({
    "@type": "Question",
    name: item.question,
    acceptedAnswer: { "@type": "Answer", text: item.answer },
  })),
};
---

<Layout
  title="Desarrollador Web Full-Stack e IA | Josué Valbuena"
  description="Desarrollador web Full-Stack freelance en Chile. Creo sitios web, tiendas online, sistemas a medida y chatbots con IA para tu negocio. Cotiza tu proyecto."
  jsonLd={[faqJsonLd]}
  ogDescription="Sitios web, web apps, chatbots y agentes de IA a medida. Mira mi portafolio y trabajemos juntos."
>
  <Hero />
  <Services />
  <Projects />
  <Process />
  <Experience />
  <Faq items={generalFaq} />
  <Contact />
</Layout>
