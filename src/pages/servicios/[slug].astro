---
import Layout from "../../layouts/Layout.astro";
import Projects from "../../components/Projects.astro";
import Process from "../../components/Process.astro";
import Contact from "../../components/Contact.astro";
import Faq from "../../components/Faq.astro";
import { projects } from "../../data/projects";
import { servicePages, type ServicePage } from "../../data/servicePages";
import { siteUrl, whatsappUrl } from "../../lib/seo";

export function getStaticPaths() {
  return servicePages.map((page) => ({
    params: { slug: page.slug },
    props: { page },
  }));
}

interface Props {
  page: ServicePage;
}

const { page } = Astro.props;
const path = `/servicios/${page.slug}/`;
const url = `${siteUrl}${path}`;
const related = projects.filter((project) =>
  page.relatedProjects.includes(project.slug),
);

const jsonLd = [
  {
    "@type": "Service",
    "@id": `${url}#service`,
    name: page.name,
    description: page.metaDescription,
    url,
    provider: { "@id": `${siteUrl}/#person` },
    areaServed: { "@type": "Country", name: "Chile" },
  },
  {
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Inicio", item: `${siteUrl}/` },
      {
        "@type": "ListItem",
        position: 2,
        name: "Servicios",
        item: `${siteUrl}/servicios/`,
      },
      { "@type": "ListItem", position: 3, name: page.navLabel, item: url },
    ],
  },
  {
    "@type": "FAQPage",
    mainEntity: page.faq.map((item) => ({
      "@type": "Question",
      name: item.question,
      acceptedAnswer: { "@type": "Answer", text: item.answer },
    })),
  },
];
---

<Layout
  title={page.metaTitle}
  description={page.metaDescription}
  path={path}
  jsonLd={jsonLd}
>
  <!-- Hero -->
  <section class="pt-32 pb-16 px-6">
    <div class="max-w-4xl mx-auto text-center">
      <nav aria-label="Ruta de navegación" class="text-sm text-muted-foreground mb-6">
        <a href="/" class="hover:text-foreground transition-colors">Inicio</a>
        <span class="mx-2">/</span>
        <a href="/servicios/" class="hover:text-foreground transition-colors">Servicios</a>
        <span class="mx-2">/</span>
        <span class="text-foreground">{page.navLabel}</span>
      </nav>

      <h1 class="text-4xl md:text-6xl font-bold font-heading mb-6 leading-tight">
        {page.h1}
      </h1>
      <p class="text-lg text-secondary-foreground/80 max-w-2xl mx-auto mb-8 leading-relaxed">
        {page.intro}
      </p>
      <a
        href={whatsappUrl(page.whatsappMessage)}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-block px-6 py-3 rounded-lg bg-primary text-primary-foreground font-medium hover-glow transition-all hover:scale-105"
      >
        Cotizar mi proyecto
      </a>
    </div>
  </section>

  <!-- Qué incluye -->
  <section class="py-16 px-6">
    <div class="max-w-6xl mx-auto">
      <h2 class="text-3xl md:text-4xl font-bold text-center mb-12">
        Qué <span class="text-gradient">incluye</span>
      </h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
        {
          page.includes.map((item) => (
            <div class="card-gradient rounded-xl p-6 border border-border">
              <h3 class="text-lg font-semibold mb-2 text-foreground">
                {item.title}
              </h3>
              <p class="text-sm text-secondary-foreground/80 leading-relaxed">
                {item.description}
              </p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Beneficios -->
  <section class="py-16 px-6">
    <div class="max-w-6xl mx-auto">
      <h2 class="text-3xl md:text-4xl font-bold text-center mb-12">
        Por qué <span class="text-gradient">conmigo</span>
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
        {
          page.benefits.map((item) => (
            <div class="rounded-xl p-6 border border-border">
              <h3 class="text-lg font-semibold mb-2 text-foreground">
                {item.title}
              </h3>
              <p class="text-sm text-secondary-foreground/80 leading-relaxed">
                {item.description}
              </p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <Process />

  {
    related.length > 0 && (
      <Projects
        items={related}
        id="proyectos-relacionados"
        heading="Proyectos"
        highlight="relacionados"
        description="Un ejemplo de lo que ya construí en esta área"
      />
    )
  }

  <Faq items={page.faq} />

  <Contact />
</Layout>
